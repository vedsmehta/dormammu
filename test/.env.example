# Copy to test/.env and fill in. test/.env is gitignored.

# --- SMS (Dial) ---
DIAL_API_KEY=
# Your Dial number to send from: E.164 (+14155550100), number id (pn_...), or nickname
DIAL_NUMBER=

# --- Calls (LiveKit Cloud + SIP trunk) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Outbound trunk id (ST_...) from LiveKit Cloud > Telephony > SIP trunks
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
# Optional overrides (LiveKit Inference model ids)
# CALL_STT=deepgram/nova-3
# CALL_LLM=openai/gpt-4.1-mini
# CALL_TTS=cartesia/sonic-3
# MAX_CONCURRENT_CALLS=10

# --- Live tests (leave blank to skip; these send a real text / place a real call) ---
TEST_SMS_TO=
TEST_CALL_TO=
