# Copy to .env at the repo root and fill in. .env is gitignored. Next.js reads the NEXT_PUBLIC_* keys at build.

# --- Dial (calls + SMS) ---
DIAL_API_KEY=
DIAL_NUMBER=                          # E.164 number to call from, provisioned in the Dial dashboard

# --- OpenAI (router + extractor) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- Supabase (auth, Postgres, Realtime) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=             # sb_publishable_... (safe in the browser)
SUPABASE_SECRET_KEY=                  # sb_secret_... SERVER ONLY, bypasses RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # same value as SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=            # same value as SUPABASE_SECRET_KEY
DATABASE_URL=                         # only for scripts/apply_migration.py (session pooler URI)

# --- Keewano (secondary event sink) ---
KEEWANO_TOKEN=
KEEWANO_ENABLED=true

# --- Service ---
MCP_SHARED_SECRET=                    # bearer the Context MCP route requires
INTERNAL_API_SECRET=                  # server-to-server bearer
NEXT_PUBLIC_BASE_URL=http://localhost:3000
DIAL_OVERHEAD_SECONDS=45              # the visible assumption behind the "est." multiplier
MAX_CALLS_PER_RUN=5
# SIMULATED_TALK_SECONDS=75           # how long a simulated row "talks"
# DORMAMMU_DRY_RUN=1                  # never dial: every row becomes a labeled simulated row
# DEV_USER_ID=                        # local only: skip auth, use SQLite

# --- Smoke test (places a real call) ---
TEST_CALL_TO=
# TEST_SMS_TO=
